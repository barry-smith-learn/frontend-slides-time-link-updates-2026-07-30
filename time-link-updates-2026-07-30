<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Time Link Project Updates</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --stage-bg: #07111d;
            --slide-bg: #091723;
            --text-primary: #f3f7ff;
            --text-secondary: #9fb0cb;
            --accent: #4fd1c5;
            --accent-2: #fdae4b;
            --accent-3: #7c93ff;
            --panel: rgba(255,255,255,0.06);
            --panel-strong: rgba(255,255,255,0.1);
            --border: rgba(255,255,255,0.14);
            --font-display: 'Space Grotesk', sans-serif;
            --font-body: 'Manrope', sans-serif;
            --title-size: 88px;
            --subtitle-size: 28px;
            --body-size: 24px;
            --small-size: 19px;
            --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
            --duration-normal: 0.7s;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        /* ===========================================
           FIXED 16:9 STAGE: MANDATORY BASE STYLES
           =========================================== */
        html,
        body {
            width: 100%;
            height: 100%;
            margin: 0;
            overflow: hidden;
            background: var(--stage-bg);
            color: var(--text-primary);
            font-family: var(--font-body);
        }

        .deck-viewport {
            position: fixed;
            inset: 0;
            overflow: hidden;
            background: var(--stage-bg);
        }

        .deck-stage {
            position: absolute;
            left: 0;
            top: 0;
            width: 1920px;
            height: 1080px;
            overflow: hidden;
            transform-origin: 0 0;
            background: var(--slide-bg);
        }

        .slide {
            position: absolute;
            inset: 0;
            width: 1920px;
            height: 1080px;
            overflow: hidden;
            display: block;
            visibility: hidden;
            opacity: 0;
            pointer-events: none;
            background: var(--slide-bg);
        }

        .slide.active,
        .slide.visible {
            visibility: visible;
            opacity: 1;
            pointer-events: auto;
            z-index: 1;
        }

        img,
        video,
        canvas,
        svg {
            max-width: 100%;
            max-height: 100%;
        }

        .deck-controls {
            position: fixed;
            left: 50%;
            bottom: 22px;
            transform: translateX(-50%);
            z-index: 1000;
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(7,17,29,.72);
            padding: 10px 16px;
            border: 1px solid var(--border);
            border-radius: 999px;
            backdrop-filter: blur(12px);
            box-shadow: 0 10px 40px rgba(0,0,0,.2);
        }

        .deck-controls span {
            font-size: 16px;
            color: var(--text-secondary);
        }

        /* ===========================================
           PRESENTATION STYLES
           =========================================== */
        .slide-shell {
            position: relative;
            width: 100%;
            height: 100%;
            padding: 72px 86px;
            overflow: hidden;
        }

        .slide-shell::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(circle at 15% 20%, rgba(79,209,197,0.16), transparent 24%),
                radial-gradient(circle at 90% 0%, rgba(253,174,75,0.16), transparent 26%),
                linear-gradient(140deg, rgba(255,255,255,0.03), transparent 55%);
            pointer-events: none;
        }

        .eyebrow {
            font-family: var(--font-display);
            font-size: 16px;
            letter-spacing: 0.28em;
            text-transform: uppercase;
            color: var(--accent);
            margin-bottom: 14px;
        }

        .title {
            font-family: var(--font-display);
            font-size: var(--title-size);
            line-height: 0.95;
            font-weight: 700;
            max-width: 1180px;
            margin-bottom: 24px;
        }

        .subtitle {
            font-size: var(--subtitle-size);
            line-height: 1.3;
            color: var(--text-secondary);
            max-width: 940px;
        }

        .body {
            font-size: var(--body-size);
            line-height: 1.5;
            color: var(--text-primary);
        }

        .small {
            font-size: var(--small-size);
            line-height: 1.45;
            color: var(--text-secondary);
        }

        .reveal {
            opacity: 0;
            transform: translateY(24px);
            transition: opacity var(--duration-normal) var(--ease-out-expo), transform var(--duration-normal) var(--ease-out-expo);
        }

        .slide.visible .reveal {
            opacity: 1;
            transform: translateY(0);
        }

        .reveal:nth-child(1) { transition-delay: 0.08s; }
        .reveal:nth-child(2) { transition-delay: 0.16s; }
        .reveal:nth-child(3) { transition-delay: 0.24s; }
        .reveal:nth-child(4) { transition-delay: 0.32s; }
        .reveal:nth-child(5) { transition-delay: 0.4s; }

        .hero-grid {
            display: grid;
            grid-template-columns: 1.15fr 0.85fr;
            gap: 36px;
            align-items: center;
            height: 100%;
            position: relative;
            z-index: 1;
        }

        .panel {
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 28px;
            padding: 28px 30px;
            box-shadow: 0 18px 45px rgba(0,0,0,0.16);
            backdrop-filter: blur(12px);
        }

        .pill {
            display: inline-block;
            padding: 8px 12px;
            border-radius: 999px;
            background: rgba(79,209,197,0.14);
            color: var(--accent);
            border: 1px solid rgba(79,209,197,0.24);
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            margin-bottom: 14px;
        }

        .bullet-list {
            list-style: none;
            display: grid;
            gap: 14px;
            margin-top: 18px;
        }

        .bullet-list li {
            position: relative;
            padding-left: 24px;
            color: var(--text-primary);
            font-size: 26px;
            line-height: 1.4;
        }

        .bullet-list li::before {
            content: '*';
            position: absolute;
            left: 0;
            color: var(--accent-2);
        }

        .value-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
            margin-top: 10px;
        }

        .value-card {
            padding: 20px 22px;
            border-radius: 18px;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.08);
        }

        .value-card strong {
            display: block;
            font-family: var(--font-display);
            font-size: 24px;
            margin-bottom: 6px;
            color: var(--accent);
        }

        .image-frame {
            position: relative;
            border-radius: 24px;
            overflow: hidden;
            background: #0b1725;
            border: 1px solid var(--border);
            box-shadow: 0 20px 50px rgba(0,0,0,0.28);
            min-height: 560px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .image-frame img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
        }

        .caption {
            margin-top: 10px;
            font-size: 18px;
            color: var(--text-secondary);
        }

        .split {
            display: grid;
            grid-template-columns: 0.95fr 1.05fr;
            gap: 30px;
            place-items: center;
            height: 100%;
            position: relative;
            z-index: 1;
        }

        .timeline {
            display: grid;
            gap: 16px;
            margin-top: 24px;
        }

        .timeline-item {
            padding: 16px 18px;
            border-radius: 16px;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.08);
        }

        .timeline-item strong {
            color: var(--accent-2);
            display: block;
            margin-bottom: 4px;
        }

        .accent-line {
            width: 92px;
            height: 5px;
            border-radius: 999px;
            background: linear-gradient(90deg, var(--accent), var(--accent-2));
            margin: 10px 0 18px;
        }

        .edit-hotzone {
            position: fixed;
            top: 0;
            left: 0;
            width: 80px;
            height: 80px;
            z-index: 10000;
            cursor: pointer;
        }

        .edit-toggle {
            position: fixed;
            top: 16px;
            right: 16px;
            z-index: 10001;
            border: 0;
            border-radius: 999px;
            padding: 10px 12px;
            background: rgba(7,17,29,.8);
            color: var(--text-primary);
            border: 1px solid var(--border);
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }

        .edit-toggle.show,
        .edit-toggle.active {
            opacity: 1;
            pointer-events: auto;
        }

        .footer-note {
            position: absolute;
            right: 86px;
            bottom: 72px;
            font-size: 16px;
            color: var(--text-secondary);
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                transition-duration: 0.2s !important;
            }
        }
    </style>
</head>
<body>
    <div class="deck-viewport">
        <main class="deck-stage" id="deckStage">
            <section class="slide active">
                <div class="slide-shell">
                    <div class="hero-grid">
                        <div>
                            <div class="eyebrow reveal">Project update</div>
                            <h1 class="title reveal">Time Link</h1>
                            <p class="subtitle reveal">A payroll rules engine that turns healthcare billing data into payroll-ready output.</p>
                            <div class="accent-line reveal"></div>
                            <div class="value-grid">
                                <div class="value-card reveal"><strong>One engine</strong><span class="small">Replace platform-specific custom payroll exports with a shared rules layer.</span></div>
                                <div class="value-card reveal"><strong>Preserve records</strong><span class="small">Keep the original medical record intact while payroll logic runs separately.</span></div>
                                <div class="value-card reveal"><strong>Automation</strong><span class="small">Automate certain pre-payroll audits that are currently manual.</span></div>
                                <div class="value-card reveal"><strong>Visibility</strong><span class="small">Improve pay visibility and approval workflows in UKG.</span></div>
                            </div>
                        </div>
                    </div>
                    <div class="footer-note">Swipe or use arrows to move</div>
                </div>
            </section>

            <section class="slide">
                <div class="slide-shell">
                    <div class="split">
                        <div>
                            <div class="eyebrow reveal">Why this matters</div>
                            <h2 class="title reveal" style="font-size: 64px;">Current exports are duplicative and brittle</h2>
                            <div class="accent-line reveal"></div>
                            <ul class="bullet-list reveal">
                                <li>Platforms: Camber, CentralReach, TREDS, Service Logs, ...</li>
                                <li>Each platform needs its own payroll export.</li>
                                <li>Changing our billing platform requires building a new export from scratch.</li>
                                <li>Payroll rules are complex. Building each export is costly.</li>
                                <li>Admins edit timesheets during manual, pre-payroll audits. Original record is obscured. 🤯</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </section>

            <section class="slide">
                <div class="slide-shell">
                    <div class="eyebrow reveal">Development surfaces</div>
                    <h2 class="title reveal" style="font-size: 58px; margin-bottom: 24px;">Two teams are shaping the solution</h2>
                    <div class="image-frame reveal">
                        <img src="data:image/png;base64," alt="Development surfaces showing LEARN and Upstart13 responsibilities" />
                    </div>
                    <p class="caption reveal">LEARN will standardize source data, while Upstart13 builds the rules engine and user experience.</p>
                </div>
            </section>

            <section class="slide">
                <div class="slide-shell">
                    <div class="eyebrow reveal">Progress update</div>
                    <h2 class="title reveal" style="font-size: 58px;">Delivery is moving from design into validation</h2>
                    <div class="split" style="grid-template-columns: 1.1fr 0.9fr;">
                        <div class="image-frame reveal">
                            <img src="data:image/png;base64," alt="Scorecard of source systems" />
                        </div>
                        <div>
                            <div class="panel reveal">
                                <div class="pill">Recent Milestones</div>
                                <ul class="bullet-list">
                                    <li>Platforms scored: Camber is our first platform for this round of implementation.</li>
                                    <li>Core rules logic is now coded for overlaps, waiting time, and reporting time.</li>
                                    <li>LEARN has automated data delivery to Time Link.</li>
                                </ul>
                            </div>  
                        </div>
                    </div>
                </div>
            </section>

            <section class="slide">
                <div class="slide-shell">
                    <div class="split">
                        <div>
                            <div class="eyebrow reveal">What comes next</div>
                            <h2 class="title reveal" style="font-size: 58px;">Validation and alignment are the next milestones</h2>
                            <div class="accent-line reveal"></div>
                            <div class="timeline reveal">
                                <div class="timeline-item"><strong>Verify UKG requirements</strong><span class="small">Confirm the technical integration requirements for UKG Work Force Management.</span></div>
                                <div class="timeline-item"><strong>Run validation tests</strong><span class="small">Compare Time Link outputs against current payroll exports.</span></div>
                                <div class="timeline-item"><strong>Finalize prior-period adjustments</strong><span class="small">Implement the adjustment logic that will be used in payroll processing.</span></div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="slide active">
                <div class="slide-shell">
                    <div class="hero-grid">
                        <div>
                            <div class="eyebrow reveal">In conclusion</div>
                            <h1 class="title reveal">Time Link</h1>
                            <p class="subtitle reveal">A payroll rules engine that turns healthcare billing data into payroll-ready output.</p>
                            <div class="accent-line reveal"></div>
                            <div class="value-grid">
                                <div class="value-card reveal"><strong>One engine</strong><span class="small">Replace platform-specific custom payroll exports with a shared rules layer.</span></div>
                                <div class="value-card reveal"><strong>Preserve records</strong><span class="small">Keep the original medical record intact while payroll logic runs separately.</span></div>
                                <div class="value-card reveal"><strong>Automation</strong><span class="small">Automate certain pre-payroll audits that are currently manual.</span></div>
                                <div class="value-card reveal"><strong>Visibility</strong><span class="small">Improve pay visibility and approval workflows in UKG.</span></div>
                            </div>
                        </div>
                    </div>
                    <div class="footer-note">Swipe or use arrows to move</div>
                </div>
            </section>
        </main>
    </div>

    <div class="edit-hotzone"></div>
    <button class="edit-toggle" id="editToggle" title="Edit mode (E)">??</button>
    <div class="deck-controls">
        <span id="pageCounter">1 / 6</span>
        <span>Space</span>
        <span>-></span>
    </div>

    <script>
        class SlidePresentation {
            constructor() {
                this.slides = Array.from(document.querySelectorAll('.slide'));
                this.currentSlide = 0;
                this.stage = document.getElementById('deckStage');
                this.pageCounter = document.getElementById('pageCounter');
                this.setupStageScale();
                this.setupKeyboardNav();
                this.setupTouchNav();
                this.setupEditControls();
                this.showSlide(0);
            }

            setupStageScale() {
                const scale = () => {
                    const factor = Math.min(window.innerWidth / 1920, window.innerHeight / 1080);
                    const x = (window.innerWidth - 1920 * factor) / 2;
                    const y = (window.innerHeight - 1080 * factor) / 2;
                    this.stage.style.transform = `translate(${x}px, ${y}px) scale(${factor})`;
                };
                scale();
                window.addEventListener('resize', scale);
            }

            setupKeyboardNav() {
                document.addEventListener('keydown', (event) => {
                    if (event.key === 'ArrowRight' || event.key === ' ' || event.key === 'PageDown') {
                        event.preventDefault();
                        this.nextSlide();
                    } else if (event.key === 'ArrowLeft' || event.key === 'PageUp') {
                        event.preventDefault();
                        this.prevSlide();
                    }
                });
            }

            setupTouchNav() {
                let startX = 0;
                document.addEventListener('touchstart', (event) => {
                    startX = event.touches[0].clientX;
                });
                document.addEventListener('touchend', (event) => {
                    const delta = event.changedTouches[0].clientX - startX;
                    if (delta < -60) this.nextSlide();
                    if (delta > 60) this.prevSlide();
                });
            }

            setupEditControls() {
                const hotzone = document.querySelector('.edit-hotzone');
                const toggle = document.getElementById('editToggle');
                let hideTimeout = null;
                let editMode = false;

                const updateToggle = () => {
                    toggle.classList.toggle('show', !editMode);
                    toggle.classList.toggle('active', editMode);
                };

                hotzone.addEventListener('mouseenter', () => {
                    clearTimeout(hideTimeout);
                    updateToggle();
                });

                hotzone.addEventListener('mouseleave', () => {
                    hideTimeout = setTimeout(() => {
                        if (!editMode) toggle.classList.remove('show');
                    }, 400);
                });

                toggle.addEventListener('mouseenter', () => clearTimeout(hideTimeout));
                toggle.addEventListener('mouseleave', () => {
                    hideTimeout = setTimeout(() => {
                        if (!editMode) toggle.classList.remove('show');
                    }, 400);
                });

                hotzone.addEventListener('click', () => {
                    editMode = !editMode;
                    this.toggleEditMode(editMode);
                    updateToggle();
                });

                toggle.addEventListener('click', () => {
                    editMode = !editMode;
                    this.toggleEditMode(editMode);
                    updateToggle();
                });

                document.addEventListener('keydown', (event) => {
                    if ((event.key === 'e' || event.key === 'E') && !event.target.getAttribute('contenteditable')) {
                        event.preventDefault();
                        editMode = !editMode;
                        this.toggleEditMode(editMode);
                        updateToggle();
                    }
                });
            }

            toggleEditMode(active) {
                const editableItems = document.querySelectorAll('[data-editable]');
                editableItems.forEach((item) => {
                    item.contentEditable = active;
                    item.classList.toggle('editing', active);
                    if (active) {
                        item.focus();
                    }
                });
            }

            nextSlide() {
                this.showSlide(this.currentSlide + 1);
            }

            prevSlide() {
                this.showSlide(this.currentSlide - 1);
            }

            updatePageCounter() {
                if (this.pageCounter) {
                    this.pageCounter.textContent = `${this.currentSlide + 1} / ${this.slides.length}`;
                }
            }

            showSlide(index) {
                this.currentSlide = Math.max(0, Math.min(index, this.slides.length - 1));
                this.slides.forEach((slide, i) => {
                    slide.classList.toggle('active', i === this.currentSlide);
                    slide.classList.toggle('visible', i === this.currentSlide);
                });
                this.updatePageCounter();
            }
        }

        new SlidePresentation();
    </script>
</body>
</html>
